# Copy to .devops.env (git-ignored). Loaded by every devops command.
# No secret values here: channel credentials go in local/secrets.env.

# Your inventory: a private repo with your sites, pipelines and reports
# (devops init creates it). Relative to the workspace, or absolute. The default
# inventory/ is git-ignored by the framework; elsewhere works the same.
# Reports and pipelines default to $DEVOPS_INVENTORY/reports and /pipelines.
# Variables exported in your shell win over this file.
DEVOPS_INVENTORY=inventory
# DEVOPS_REPORTS=
# DEVOPS_PIPELINES=

# Notification channels, comma-separated: stdout, macos, ntfy, discord, matrix, webhook
DEVOPS_NOTIFY=stdout,macos

# Repeat CRIT notifications every N hours while they stay CRIT.
DEVOPS_CRIT_REMIND_HOURS=6

# ssh: extra options, connect timeout, and multiplexing (set NOMUX=1 to disable).
# launchd/cron jobs do not see your ssh-agent; use a key with IdentityFile in
# ~/.ssh/config (UseKeychain yes on macOS) so BatchMode works unattended.
DEVOPS_SSH_OPTS=
DEVOPS_SSH_TIMEOUT=10
# DEVOPS_SSH_NOMUX=1

# Health checks
DEVOPS_CHECK_TIMEOUT=90
DEVOPS_HTTP_SLOW_SECONDS=3

# Override the public endpoints (defaults come from the network preset in
# networks/, plus any overrides in your inventory's network.yaml).
# DEVOPS_RPC=https://public.testnet.structs.network:26657
# DEVOPS_LCD=https://public.testnet.structs.network
